# ==============================================================================
# BIKE ERP - Environment Variables Template
# PostgreSQL Database & High-Volume Motorcycle Spare-Parts Enterprise ERP
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER & RUNTIME ENVIRONMENT
# ------------------------------------------------------------------------------
# Options: development | test | production
NODE_ENV=production
PORT=5000
API_PREFIX=/api

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL / Prisma ORM)
# ------------------------------------------------------------------------------
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public&connection_limit=20&pool_timeout=10
DATABASE_URL="postgresql://bike_erp_user:CHANGE_ME_SECURE_PASSWORD@localhost:5432/bike_erp_db?schema=public&connection_limit=25&pool_timeout=15"

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & JWT CRYPTOGRAPHIC SECRETS
# ------------------------------------------------------------------------------
# Generate strong 256-bit keys using: openssl rand -base64 48
JWT_SECRET="REPLACE_WITH_MINIMUM_64_CHARACTERS_CRYPTOGRAPHIC_SECRET_KEY_FOR_PROD"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="REPLACE_WITH_SEPARATE_64_CHARACTERS_REFRESH_SECRET_KEY_FOR_PROD"
JWT_REFRESH_EXPIRES_IN="7d"

# ------------------------------------------------------------------------------
# 4. CORS & NETWORK SECURITY
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins (Do NOT use '*' in production)
CORS_ORIGIN="https://erp.balajimotors.com,https://pos.balajimotors.com"

# ------------------------------------------------------------------------------
# 5. API RATE LIMITING (DDoS & Brute Force Prevention)
# ------------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000       # 15 minutes (in milliseconds)
RATE_LIMIT_MAX_REQUESTS=1000     # Max requests per window per IP
AUTH_RATE_LIMIT_MAX_REQUESTS=10  # Max login attempts per 15 minutes

# ------------------------------------------------------------------------------
# 6. INITIAL SUPER ADMIN BOOTSTRAP (For first-time automated seeding)
# ------------------------------------------------------------------------------
ADMIN_INITIAL_USERNAME="superadmin"
ADMIN_INITIAL_PASSWORD="ChangeMe@StrongPassword2026!"
ADMIN_INITIAL_EMAIL="admin@balajimotors.com"
ADMIN_INITIAL_FULL_NAME="System Super Administrator"

# ------------------------------------------------------------------------------
# 7. BACKUP & STORAGE PATHS
# ------------------------------------------------------------------------------
BACKUP_STORAGE_DIR="./backups"
BACKUP_AUTO_RETENTION_DAYS=90
